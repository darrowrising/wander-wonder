rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Keep in sync with src/config/admin.ts
    function isAdmin() {
      return signedIn() && request.auth.token.email in [
        'benellisdev@gmail.com',
        '2ben.ellis@gmail.com',
      ];
    }

    function tripData() {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /legacyImports/{id} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /joinCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn();
    }

    match /trips/{tripId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.endsAt is timestamp;
      allow update: if signedIn() && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        )
        || (
          request.auth.uid == resource.data.hostUid
          && !('endsAt' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endsAt'])
          && request.resource.data.endsAt is timestamp
        )
      );

      match /members/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid;
      }

      // Anyone signed in can already read this trip by ID (the share link).
      // The UI still requires joining before you can tap plates.
      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if signedIn();
      }
    }

    match /games/{id} {
      allow read, write: if isAdmin();
    }

    match /stats/{id} {
      allow read, write: if isAdmin();
    }
  }
}
