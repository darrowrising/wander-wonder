rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function tripData() {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }

    function isLive(data) {
      return !('endsAt' in data) || data.endsAt >= request.time;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /legacyImports/{id} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /joinCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn();
    }

    match /trips/{tripId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.endsAt is timestamp;
      allow update: if signedIn() && (
        (
          isLive(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        )
        || (
          request.auth.uid == resource.data.hostUid
          && !('endsAt' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endsAt'])
          && request.resource.data.endsAt is timestamp
        )
      );

      match /members/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && (isLive(tripData()) || request.auth.uid == tripData().hostUid);
      }

      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.auth.uid in tripData().memberUids
          && (
            isLive(tripData())
            || (
              request.resource.data.imported == true
              && request.auth.uid == tripData().hostUid
            )
          );
      }
    }

    match /games/{id} {
      allow read: if signedIn();
    }

    match /stats/{id} {
      allow read: if signedIn();
    }
  }
}
